    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
